# Required
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
GEMINI_API_KEY=

# Optional overrides
GEMINI_EXERCISE_MODEL=gemini-3.5-flash-lite
